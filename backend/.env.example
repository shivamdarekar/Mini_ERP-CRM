PORT=5000
NODE_ENV=development

# Allowed CORS origins (comma-separated). Required in production.
# Example: CORS_ORIGIN=https://your-frontend.com
# Falls back to CLIENT_URL if CORS_ORIGIN is not set.
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/erp_crm

# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
